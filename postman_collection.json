{
  "info": {
    "name": "Lab07 CRUD Libros Autores",
    "_postman_id": "9b22c6f4-e8d2-4a3d-b4f5-1b8f20f29c30",
    "description": "Colección para registro/login y CRUD de autores/libros con JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Demo\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/signup"
      }
    },
    {
      "name": "Auth - Signin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/signin"
      }
    },
    {
      "name": "Autores - Crear",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_autor\": \"Isabel Allende\",\n  \"pais_origen\": \"Chile\",\n  \"fecha_nacimiento\": \"1942-08-02\"\n}"
        },
        "url": "{{base_url}}/api/autores"
      }
    },
    {
      "name": "Autores - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/autores"
      }
    },
    {
      "name": "Autores - Editar",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pais_origen\": \"Chile - Actualizado\"\n}"
        },
        "url": "{{base_url}}/api/autores/{{autor_id}}"
      }
    },
    {
      "name": "Autores - Eliminar",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/autores/{{autor_id}}"
      }
    },
    {
      "name": "Libros - Crear",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Libro Demo\",\n  \"anio_publicacion\": 2024,\n  \"portada\": \"https://picsum.photos/300/450\",\n  \"derechos\": \"Reservados\",\n  \"id_autor\": {{autor_id}}\n}"
        },
        "url": "{{base_url}}/api/libros"
      }
    },
    {
      "name": "Libros - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/libros"
      }
    },
    {
      "name": "Libros - Editar",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Libro Demo Editado\"\n}"
        },
        "url": "{{base_url}}/api/libros/{{libro_id}}"
      }
    },
    {
      "name": "Libros - Eliminar",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/libros/{{libro_id}}"
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "test_email", "value": "tucorreo+lab07@gmail.com" },
    { "key": "test_password", "value": "123456" },
    { "key": "autor_id", "value": "1" },
    { "key": "libro_id", "value": "1" }
  ]
}
